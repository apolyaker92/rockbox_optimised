# Cicumpunct Δ
# Date: 05-24-2025


# Actual theme starts here

# Disable Status Bar
%wd

# Clear Backdrop
%X(d)

# Preload Fonts
%Fl(3,14-LanaPixel-trim.fnt)
%Fl(4,10-ProFont.fnt)
%Fl(5,07-LanaPixel-trim.fnt)
%Fl(7,20-digital7mono.fnt)

# Preload Images
%xl(battery,battery.bmp,0,0,10)
%xl(iartist,artist.bmp,0,0)
%xl(ialbum,album.bmp,0,0)
%xl(ititle,track.bmp,0,0)
%xl(playmodes,playmodes.bmp,0,0,9)
%xl(pbbd,progressbar_backdrop.bmp,0,0)
%xl(volbg,volbg.bmp,0,0)
%xl(vol,vol.bmp,0,0)

# Display Viewports
%V(0,0,-,-,-)
%?mh<%Vd(lockscreen)|%Vd(metadata)>
%?Lh<%Vd(lyr)|%Vd(vis)>

##################################
##### Locked (BW Monochrome) #####
##################################

# Clear Display
%Vl(lockscreen,0,0,320,240,-)

# Battery Indicator
%Vl(lockscreen,120,160,80,-,7)
%ac%bl%%

# Charging Indicator
%Vl(lockscreen,120,140,80,-,5)
%ac%?bc<Charging|Voltage>

# Lock Indicator
%Vl(lockscreen,215,45,85,25,7)
%ac%?mh<LOCKED%Vs(invert)|>

# Artist
%Vl(lockscreen,20,40,188,30,3)
%al%s%ia

# Track Title or Filename
%Vl(lockscreen,17,65,280,30,3)
%al%s%it

# Album Title and ID3 Year
%Vl(lockscreen,20,105,190,15,5)
%al%s%id %(%ss(0,4, %iy)%)

# Shuffle Indicator
%Vl(lockscreen,220,109,23,12,4)
%al%?ps<SHUF>

# Repeat Indicator
%Vl(lockscreen,245,109,35,12,4)
%ac%?mm<|REPEAT|REPEAT|REPEAT|REPEAT>

# Repeat Mode Indicator
%Vl(lockscreen,284,109,17,12,4)
%ar%?mm<|ALL|ONE|SFL|A-B>


#######################
##### Play Screen #####
#######################

# Clear Display
%Vl(metadata,0,0,320,240,-)

# Playback Mode Icons
%Vl(metadata,20,12,25,13,-)
%xd(playmodes,%mp)

# Volume readout, top left next to the play icon
%Vl(metadata,40,14,76,12,4)
%al%?if(%pv, >, 0)<+|>%pvdB

# Track Number
%Vl(metadata,120,10,80,19,5)
%ac%pp %Sx(of) %pe

# Battery (graphical)
%Vl(metadata,277,13,23,10,-)
%?if(%bl,>,90)<%xd(battery,10)|%?if(%bl,>,80)<%xd(battery,9)|%?if(%bl,>,70)<%xd(battery,8)|%?if(%bl,>,60)<%xd(battery,7)|%?if(%bl,>,50)<%xd(battery,6)|%?if(%bl,>,40)<%xd(battery,5)|%?if(%bl,>,30)<%xd(battery,4)|%?if(%bl,>,20)<%xd(battery,3)|%?if(%bl,>,10)<%xd(battery,2)|%?if(%bl,>,-1)<%xd(battery,1)>>>>>>>>>>

# Artist icon
%Vl(metadata,20,49,14,14,-)
%xd(iartist)

# Artist
%Vl(metadata,38,40,170,30,3)
%al%s%ia

# Codec box
%Vl(metadata,215,48,40,15,7)
%ac%?fc<MP1|MP2|MP3|AIFF|WAV|VORBIS|FLAC|MPC|AC3|WAVPAC|ALAC|AAC|SHORTEN|SID|ADX|NSF|SPEEX|SPC|APE|WMA|WMAPRO|MOD|SAP|COOK|AAC|AC3|ATRAC3|CMC|CM3|CMR|CMS|DMC|DLT|MPT|MPD|RMT|TMC|TM8|TM2|ATRAC3|SMAF|AU|VOX|WAVE64|TRUEAUD|WMAVOX|MUSEPAK|AAC-HE|AY|VTX|GBS|HES|SGC|VGM|KSS|OPUS|AAC|UNKNOWN?>%Vs(invert)

# Bitrate box
%Vl(metadata,260,48,40,15,7)
%ac%fbk%Vs(invert)

# Track icon
%Vl(metadata,20,74,14,14,-)
%xd(ititle)

# Track Title or Filename
%Vl(metadata,38,65,262,30,3)
%al%s%it

# Album icon
%Vl(metadata,20,101,14,14,-)
%xd(ialbum)

# Album title and year
%Vl(metadata,38,100,157,15,5)
%al%s%id %(%ss(0,4, %iy)%)

# Shuffle and repeat flags, right end of the album row
%Vl(metadata,200,104,100,11,4)
%ar%?ps<SHUF |>%?mm<|RPT ALL|RPT ONE|RPT SFL|RPT A-B>

# Lyrics or bands mode, top right (Select+Menu changes it)
%Vl(metadata,205,14,66,12,4)
%ar%Lm

# Divider above the lyrics / visualizer
%Vl(metadata,20,121,280,2,-)
%dr(0,0,280,1)

# Divider below the lyrics / visualizer
%Vl(metadata,20,196,280,2,-)
%dr(0,0,280,1)

# Time Elapsed
%Vl(metadata,18,205,35,15,7)
%al%pc

# Progress Bar
%Vl(metadata,60,208,200,11,-)
%pb(0,0,200,9,progressbar.bmp,backdrop,pbbd)

# Total Track Time
%Vl(metadata,266,205,35,15,7)
%ac%pt

# Lyrics (needs the firmware with the %Lk tag)
# Current line word-wrapped, sung part in the theme colour and the part still
# to come in grey, then the next line in grey underneath. No scrolling.
%Vl(lyr,20,126,280,64,5)
%Lk(0,6,280,51)

# Band visualizer, for tracks without lyrics (needs the %Lz tag)
%Vl(vis,20,126,280,64,-)
%Lz(0,4,28,56,vertical,noborder,band0)%Lz(36,4,28,56,vertical,noborder,band1)%Lz(72,4,28,56,vertical,noborder,band2)%Lz(108,4,28,56,vertical,noborder,band3)%Lz(144,4,28,56,vertical,noborder,band4)%Lz(180,4,28,56,vertical,noborder,band5)%Lz(216,4,28,56,vertical,noborder,band6)%Lz(252,4,28,56,vertical,noborder,band7)
